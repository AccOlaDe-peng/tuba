# Copy to the environment_file path in the service manifest and restrict access to the Launcher account.
KAFKA_BROKERS=127.0.0.1:9092
TUBA_ORGANIZATION_ID=replace-with-organization
TUBA_NAMESPACE=replace-with-namespace
DATABASE_URL=postgres://tuba_runtime:replace-me@127.0.0.1:5432/tuba?sslmode=disable
TUBA_RELEASE_ROOT=/var/lib/tuba/releases
# Auto case creation is default-off (design baseline): one case per
# tenant/entity/policy/time_bucket dedupe key, anomaly links accumulate.
TUBA_AUTO_CASE_ENABLED=false
# Q03 asynchronous exports: controlled local directory shared by tuba-api and
# tuba-control-worker (same host). Empty disables exports fail-closed.
TUBA_EXPORT_DIR=
# Control worker needs a read-only event-store key for export execution.
TUBA_CONTROL_WORKER_ES_API_KEY=replace-me-control-worker-es-key
PG_STATEMENT_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=30s
ES_URL=http://127.0.0.1:9200
# Provision separate keys with only the required index privileges; these placeholders are not interchangeable.
TUBA_API_ES_API_KEY=replace-me-api-key
TUBA_RAW_INDEXER_ES_API_KEY=replace-me-raw-indexer-key
TUBA_QUARANTINE_INDEXER_ES_API_KEY=replace-me-quarantine-indexer-key
TUBA_STANDARD_INDEXER_ES_API_KEY=replace-me-standard-indexer-key
TUBA_ANALYSIS_SINK_ES_API_KEY=replace-me-analysis-sink-key
OIDC_ISSUER=http://127.0.0.1:8180/realms/tuba
OIDC_CLIENT_ID=tuba-web
OIDC_AUDIENCE=tuba-api
OIDC_JWKS_URL=http://127.0.0.1:8180/realms/tuba/protocol/openid-connect/certs

# Provision each identity separately and grant only the topic/group ACLs it needs.
TUBA_INGEST_KAFKA_USER=tuba-zeek-ingest
TUBA_INGEST_KAFKA_PASSWORD=replace-me
TUBA_NORMALIZER_KAFKA_USER=tuba-zeek-normalizer
TUBA_NORMALIZER_KAFKA_PASSWORD=replace-me
TUBA_RAW_INDEXER_KAFKA_USER=tuba-zeek-raw-indexer
TUBA_RAW_INDEXER_KAFKA_PASSWORD=replace-me
TUBA_QUARANTINE_INDEXER_KAFKA_USER=tuba-zeek-quarantine-indexer
TUBA_QUARANTINE_INDEXER_KAFKA_PASSWORD=replace-me
TUBA_STANDARD_INDEXER_KAFKA_USER=tuba-zeek-standard-indexer
TUBA_STANDARD_INDEXER_KAFKA_PASSWORD=replace-me
TUBA_CONTROL_WORKER_KAFKA_USER=tuba-control-worker
TUBA_CONTROL_WORKER_KAFKA_PASSWORD=replace-me
TUBA_ANALYSIS_SINK_KAFKA_USER=tuba-analysis-sink
TUBA_ANALYSIS_SINK_KAFKA_PASSWORD=replace-me
TUBA_SOURCE_ADAPTER_KAFKA_USER=tuba-zeek-source-adapter
TUBA_SOURCE_ADAPTER_KAFKA_PASSWORD=replace-me
SOURCE_ADAPTER_TOKEN=replace-with-a-random-token-of-at-least-32-characters
