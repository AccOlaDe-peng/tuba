KAFKA_BROKERS=127.0.0.1:9092
KAFKA_RAW_TOPIC=tuba.raw.events.v1
KAFKA_QUARANTINE_TOPIC=tuba.quarantine.v1
KAFKA_EVENTS_TOPIC=tuba.events.authentication.v1
KAFKA_DLQ_TOPIC=tuba.indexing.dlq.v1
KAFKA_ANALYSIS_RESULTS_TOPIC=tuba.analysis.results.v1
TUBA_ORGANIZATION_ID=tenant_a
TUBA_NAMESPACE=tenant_a
ES_URL=http://127.0.0.1:9200
ES_API_KEY=local-dev-only
DATABASE_URL=postgres://tuba_runtime:tuba-runtime-local-only@127.0.0.1:5432/tuba?sslmode=disable
DATABASE_MIGRATION_URL=postgres://tuba:tuba-local-only@127.0.0.1:5432/tuba?sslmode=disable
TUBA_RUNTIME_DB_USER=tuba_runtime
TUBA_RUNTIME_DB_PASSWORD=tuba-runtime-local-only
TUBA_MIGRATION_DB_USER=tuba
POSTGRES_DB=tuba
POSTGRES_USER=tuba
POSTGRES_PASSWORD=tuba-local-only
HTTP_LISTEN=127.0.0.1:8080
API_LISTEN=127.0.0.1:8788
HTTP_REQUEST_TIMEOUT=30s
PG_STATEMENT_TIMEOUT=15s

# M1 ingestion/indexing controls
INGEST_RATE_PER_SECOND=1000
INGEST_RATE_BURST=2000
INDEX_BATCH_SIZE=500
INDEX_BATCH_BYTES=16777216
INDEX_BATCH_WAIT=1s
INDEX_MAX_ATTEMPTS=5
INDEX_RETRY_BACKOFF=200ms
METRICS_LISTEN=127.0.0.1:9090

# plaintext | tls | sasl_plaintext | sasl_tls
KAFKA_SECURITY_PROTOCOL=plaintext
# none | plain | scram-sha256 | scram-sha512
KAFKA_SASL_MECHANISM=none
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TLS_CA_FILE=
KAFKA_TLS_CERT_FILE=
KAFKA_TLS_KEY_FILE=
KAFKA_TLS_SERVER_NAME=

# Web system login uses the same-origin API

# wang.min=tenant_admin, analyst.lee=analyst, auditor.zhao=viewer

# Native system login; secure cookies required on the deployed HTTPS gateway.
TUBA_PUBLIC_ORIGIN=http://127.0.0.1:5173
TUBA_AUTH_COOKIE_SECURE=false
TUBA_AUTH_SESSION_TTL=8h
