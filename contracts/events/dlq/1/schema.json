{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuba.local/contracts/events/dlq/1/schema.json",
  "title": "TUBA Dead Letter Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source",
    "failure",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "partition",
        "offset"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "partition": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "code",
        "retryable",
        "occurred_at",
        "attempts"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "retryable": {
          "type": "boolean"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "service_version": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "payload": {
      "type": [
        "object",
        "array",
        "string",
        "null"
      ]
    }
  }
}
