{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuba.local/contracts/events/analysis-result/2/schema.json",
  "title": "TUBA Derived Object Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "object_type", "object_id", "revision", "operation", "generation", "organization_id", "namespace", "rule_id", "rule_version", "run_id", "window_start", "date_key", "input_refs", "document"],
  "properties": {
    "contract_version": {"type": "string", "const": "2.0.0"},
    "object_type": {"type": "string", "enum": ["feature", "baseline", "anomaly", "risk_event", "entity_risk"]},
    "object_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "revision": {"type": "integer", "minimum": 1},
    "operation": {"type": "string", "enum": ["upsert", "retracted"]},
    "generation": {"type": "string", "minLength": 1, "maxLength": 128},
    "organization_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "namespace": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "rule_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "rule_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "window_start": {"type": "string", "format": "date-time"},
    "date_key": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "input_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["object_type", "object_id"], "properties": {"object_type": {"type": "string", "minLength": 1}, "object_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "document": {"type": "object"}
  }
}
