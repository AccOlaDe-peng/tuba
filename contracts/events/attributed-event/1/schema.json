{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuba.local/contracts/events/attributed-event/1/schema.json",
  "title": "TUBA Attributed Event Contribution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "organization_id", "event_id", "event_time", "attribution_id", "role", "state", "confidence", "rule_version", "partition_key", "evidence"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "organization_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "event_time": {"type": "string", "format": "date-time"},
    "domain": {"type": "string", "enum": ["authentication", "session", "iam", "directory", "network", "dns", "web", "tls"]},
    "attribution_id": {"type": "string", "pattern": "^att:[a-f0-9]{64}$"},
    "role": {"type": "string", "enum": ["actor", "target", "group", "host", "source_device", "destination_device"]},
    "state": {"type": "string", "enum": ["resolved", "unresolved", "ambiguous"]},
    "entity_id": {"type": "string", "pattern": "^ent:[a-f0-9]{64}$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rule_version": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "enum": ["no_identifiers", "identifier_invalid", "identity_space_unregistered", "no_matching_entity", "no_active_occurrence_at_event_time", "strong_weak_conflict", "multiple_active_candidates"]},
    "partition_key": {"type": "string", "minLength": 1},
    "evidence": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "resolved"}}},
      "then": {"required": ["entity_id"]},
      "else": {"not": {"required": ["entity_id"]}}
    },
    {
      "if": {"properties": {"state": {"enum": ["unresolved", "ambiguous"]}}},
      "then": {"required": ["reason"]}
    }
  ]
}
